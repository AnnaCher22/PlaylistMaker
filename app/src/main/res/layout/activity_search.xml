<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/setting_layout">

    <LinearLayout
        style="@style/topSearch"       >
        <ImageButton
            android:id="@+id/backSearch"
            style="@style/button_back"
            android:src="@drawable/back_button"
            android:importantForAccessibility="no"/>

        <TextView
            style="@style/textTopSettings"
            android:text="@string/search" />

    </LinearLayout>


    <FrameLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/clearIcon"
            style="@style/icon_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:visibility="gone"
            app:srcCompat="@drawable/clear" />

        <EditText
            android:id="@+id/searchView"
            style="@style/edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:background="@drawable/edit_text_background"
            android:clipToOutline="true"
            android:drawablePadding="8dp"
            android:hint="@string/search"
            android:imeOptions="actionDone"
            android:importantForAccessibility="no"
            android:inputType="text"
            android:lines="1"
            android:maxLines="30"
            android:minHeight="@dimen/min_height_48"
            android:outlineProvider="none"
            />

    </FrameLayout>

    <TextView android:id="@+id/searchHint"
        style="@style/search_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_search_hint"
        android:visibility="gone"/>




    </LinearLayout>